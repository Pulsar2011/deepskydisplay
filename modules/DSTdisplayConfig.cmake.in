@PACKAGE_INIT@

# find_dependency() runs the config files of the dependencies in this scope, and those generated
# with @PACKAGE_INIT@ (Qt6 installed in /usr by a Linux distribution, ...) overwrite PACKAGE_PREFIX_DIR:
# keep our own copy, taken before any find_dependency().
set(_DSTdisplay_PREFIX "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(DSTfits @DSTfits_MIN_VERSION@ HINTS "${_DSTdisplay_PREFIX}")

set(DSTdisplay_QT_LIBS "@QT_LIBS@")
if(DSTdisplay_QT_LIBS)
    find_dependency(Qt6 COMPONENTS Widgets Core Gui PrintSupport Concurrent)
endif()

if(NOT TARGET DSTdisplay::DSTdisplay)
    add_library(DSTdisplay::DSTdisplay SHARED IMPORTED)
    set_target_properties(DSTdisplay::DSTdisplay PROPERTIES
        IMPORTED_LOCATION "${_DSTdisplay_PREFIX}/lib/libDSTdisplay${CMAKE_SHARED_LIBRARY_SUFFIX}"
        INTERFACE_INCLUDE_DIRECTORIES "${_DSTdisplay_PREFIX}/include"
        INTERFACE_LINK_LIBRARIES "DSTfits::DSTfits;${DSTdisplay_QT_LIBS}"
    )
    if(DSTdisplay_QT_LIBS)
        set_target_properties(DSTdisplay::DSTdisplay PROPERTIES
            INTERFACE_COMPILE_DEFINITIONS "__WITH_QT__"
        )
    endif()
endif()
unset(_DSTdisplay_PREFIX)

check_required_components(DSTdisplay)
